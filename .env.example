# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Neon PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# JWT_SECRET: Secret key used to sign auth tokens.
JWT_SECRET="change-me-to-a-long-random-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Storage (recommended for persistent salon photo uploads on live/serverless)
# Keep service role key server-only; never expose it in frontend code.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional bucket/folder. Bucket should be public if frontend loads image URLs directly.
SUPABASE_STORAGE_BUCKET="salon-images"
SUPABASE_STORAGE_FOLDER="salons"

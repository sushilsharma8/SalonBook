# GEMINI_API_KEY: Optional. Powers Map Explorer AI and server-side menu photo extraction.
# Keep this server-only for menu import; do not expose in frontend bundles for new features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MENU_MODEL: Optional preferred first model for rate-list OCR.
GEMINI_MENU_MODEL="gemini-2.5-flash"

# GEMINI_MENU_MODELS: Optional comma-separated fallback chain (tried in order when a model is busy).
# GEMINI_MENU_MODELS="gemini-2.5-flash,gemini-3.5-flash"

# DATABASE_URL: Neon PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# JWT_SECRET: Secret key used to sign auth tokens.
JWT_SECRET="change-me-to-a-long-random-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and sitemap.xml.
APP_URL="MY_APP_URL"

# WHATSAPP_API_URL: Optional Venom API base URL for server-side owner notifications.
# Example: http://localhost:3001
WHATSAPP_API_URL=""

# PostHog analytics (frontend — safe to expose project key)
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Supabase Storage (recommended for persistent salon photo uploads on live/serverless)
# Keep service role key server-only; never expose it in frontend code.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional bucket/folder. Bucket should be public if frontend loads image URLs directly.
SUPABASE_STORAGE_BUCKET="salon-images"
SUPABASE_STORAGE_FOLDER="salons"
